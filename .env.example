# =============================================================================
# Swanford Academy Management System - Environment Variables Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env` for local development:
#    cp .env.example .env
# 2. NEVER commit `.env`, `.env.production`, or real secret keys to source control.
# 3. Fill in the values for your target deployment environment.
# =============================================================================

# Application Runtime
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL Database Configuration
DATABASE_URL=
DIRECT_URL= 

# Security & Session Cryptography (minimum 32 characters)
SESSION_SECRET=

# Scheduled Cron Security (matches Vercel Cron Authorization header)
CRON_SECRET=

# Payment Gateway (Paystack Integration)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Notification Service (mock | smtp | termii)
NOTIFICATION_PROVIDER=smtp

# SMTP / Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Swanford Academy
SMTP_FROM_EMAIL=
SMTP_CONNECTION_TIMEOUT=10000
SMTP_RETRY_LIMIT=5 
