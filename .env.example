# =============================================================================
# Swanford Academy Management System - Environment Variables Template
# =============================================================================
# Master Specification Reference: Sections 8, 9, 14, 16
#
# INSTRUCTIONS:
# 1. Copy this file to `.env` for local development:
#    cp .env.example .env
# 2. NEVER commit `.env`, `.env.production`, or real secret keys to source control.
# 3. Keep Local, Staging, and Production databases and secrets strictly separated.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & ENVIRONMENT
# -----------------------------------------------------------------------------
# Options: development | test | production
NODE_ENV=development

# Base URL for application links, redirection, and Paystack callback URLs
# Local: http://localhost:3000
# Staging: https://staging.swanfordacademy.edu.ng (or Vercel preview)
# Production: https://swanfordacademy.edu.ng
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL)
# -----------------------------------------------------------------------------
# PostgreSQL connection string for connection pooling (PgBouncer) or direct connection.
# Local: postgresql://postgres:postgres@localhost:5432/swanford_local?schema=public
# Staging: postgresql://user:pass@staging-host:5432/swanford_staging?schema=public
# Production: postgresql://user:pass@production-host:5432/swanford_prod?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/swanford_local?schema=public"

# Direct URL for Prisma migrations (bypassing connection poolers like PgBouncer)
# Optional in local development; required for pooled cloud setups.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/swanford_local?schema=public"

# -----------------------------------------------------------------------------
# 3. SECURITY, SESSION & CRYPTOGRAPHY
# -----------------------------------------------------------------------------
# Cryptographic secret key used to sign HTTP-only session cookies and tokens.
# Must be at least 32 random characters in production. Generate with `openssl rand -base64 32`.
SESSION_SECRET="development_session_secret_replace_in_production_min_32_chars"

# -----------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (PAYSTACK INTEGRATION)
# -----------------------------------------------------------------------------
# Paystack API Keys.
# LOCAL / STAGING: Must use Test keys (`sk_test_...` and `pk_test_...`)
# PRODUCTION: Use Live keys (`sk_live_...` and `pk_live_...`)
# CRITICAL: Never use live credentials in local development or staging tests!
PAYSTACK_SECRET_KEY="sk_test_placeholder_secret_key_from_paystack_dashboard"
PAYSTACK_PUBLIC_KEY="pk_test_placeholder_public_key_from_paystack_dashboard"

# Secret hash configured in Paystack dashboard for verifying webhook payload signatures.
PAYSTACK_WEBHOOK_SECRET="test_webhook_signature_secret"

# -----------------------------------------------------------------------------
# 5. NOTIFICATION SERVICE ABSTRACTION
# -----------------------------------------------------------------------------
# Provider for system emails and SMS/WhatsApp communications.
# Options: mock | smtp | termii
NOTIFICATION_PROVIDER="mock"

# Optional SMTP Settings (required if NOTIFICATION_PROVIDER=smtp)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Swanford Academy <no-reply@swanfordacademy.edu.ng>"
