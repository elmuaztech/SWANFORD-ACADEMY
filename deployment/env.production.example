# =============================================================================
# Swanford Academy Management System - Production Environment Template
# =============================================================================
# Application Runtime
NODE_ENV=production
APP_URL=https://swanfordacademy.com.ng

# PostgreSQL Database Configuration (Isolated Swanford DB)
POSTGRES_USER=swanford
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_POSTGRES_PASSWORD
POSTGRES_DB=swanford_prod
DATABASE_URL=postgresql://swanford:CHANGE_ME_IN_PRODUCTION_POSTGRES_PASSWORD@postgres:5432/swanford_prod?schema=public
DIRECT_URL=postgresql://swanford:CHANGE_ME_IN_PRODUCTION_POSTGRES_PASSWORD@postgres:5432/swanford_prod?schema=public

# Security & Session Cryptography (Generate via: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS_SESSION_SECRET

# Scheduled Cron Security (Generate via: openssl rand -hex 24)
CRON_SECRET=CHANGE_ME_IN_PRODUCTION_CRON_SECRET

# Payment Gateway (Paystack Integration)
PAYSTACK_SECRET_KEY=sk_live_REPLACE_WITH_PRODUCTION_LIVE_KEY
PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_WITH_PRODUCTION_PUBLIC_KEY
PAYSTACK_WEBHOOK_SECRET=CHANGE_ME_IN_PRODUCTION_PAYSTACK_WEBHOOK_SECRET

# Notification Service (mock | smtp | termii)
NOTIFICATION_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=swanford99@gmail.com
SMTP_PASSWORD=REPLACE_WITH_GOOGLE_APP_PASSWORD
SMTP_PASS=REPLACE_WITH_GOOGLE_APP_PASSWORD
SMTP_FROM_NAME="Swanford Academy"
SMTP_FROM_EMAIL=swanford99@gmail.com
SMTP_CONNECTION_TIMEOUT=10000
SMTP_RETRY_LIMIT=5
